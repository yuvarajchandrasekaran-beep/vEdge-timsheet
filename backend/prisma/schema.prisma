// TimeSync data model.
//
// Provider is SQLite for zero-install local development. SQLite has no native
// enum type, so enum-like columns are plain String columns constrained by the
// app layer (see src/constants/enums.ts) — switching `provider` to "mysql" and
// pointing DATABASE_URL at a real MySQL instance is the only change needed to
// run this schema in production; the String columns can optionally be
// promoted to native Prisma `enum` at that point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // SUPER_ADMIN | HR_ADMIN | PROJECT_ADMIN | INDIVIDUAL_USER
  users User[]

  @@map("roles")
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String
  code  String @unique
  users User[]

  @@map("departments")
}

model User {
  id             Int       @id @default(autoincrement())
  employeeId     String    @unique
  name           String
  email          String    @unique
  passwordHash   String
  roleId         Int
  role           Role      @relation(fields: [roleId], references: [id])
  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id])
  jobTitle       String?
  managerId      Int?
  manager        User?     @relation("UserManager", fields: [managerId], references: [id])
  reports        User[]    @relation("UserManager")
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE
  startDate      DateTime?
  timezone       String    @default("Asia/Kolkata")
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projectMembers    ProjectMember[]
  timesheets        Timesheet[]
  approvalsActed    Approval[]        @relation("ApproverActions")
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("AuditActor")
  auditLogsImpersonated AuditLog[]    @relation("AuditImpersonator")
  importBatches     ImportBatch[]     @relation("ImportUploader")
  delegationsFrom   Delegation[]      @relation("DelegationFrom")
  delegationsTo     Delegation[]      @relation("DelegationTo")
  clientTimesheetSends ClientTimesheetSend[] @relation("ClientSendSentBy")

  @@map("users")
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  status   String    @default("ACTIVE") // ACTIVE | INACTIVE
  projects Project[]

  // A client has at most one holiday calendar at a time; the same calendar
  // can be reused across several clients (e.g. all US-based clients sharing
  // one US federal calendar) — see HolidayCalendar.
  holidayCalendarId Int?
  holidayCalendar   HolidayCalendar? @relation(fields: [holidayCalendarId], references: [id])

  @@map("clients")
}

model Project {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id])
  code          String    @unique
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  status        String    @default("ACTIVE") // ACTIVE | ON_HOLD | ARCHIVED | COMPLETED
  billingType   String    @default("T_AND_M") // T_AND_M | FIXED | MANAGED_SERVICES — the contract type; billable/non-billable is now captured per-task (see ProjectTask.billable)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Budget hours are NOT stored here — they're rolled up bottoms-up from
  // ProjectTask.estimatedHours (see utils/projectHours.ts). A project can
  // have more than one admin: any ProjectMember row with
  // roleOnProject = "Project Admin" (see ProjectMember below).
  tasks         ProjectTask[]
  members       ProjectMember[]

  // Client timesheet delivery (per client-project combination — a project
  // belongs to exactly one client, so this lives directly on Project).
  sendTimesheetToClient Boolean @default(false)
  clientContactEmail    String? // prefilled default on the send screen, editable per send
  clientSends           ClientTimesheetSend[]

  @@map("projects")
}

model ProjectTask {
  id             Int       @id @default(autoincrement())
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id])
  name           String
  startDate      DateTime?
  endDate        DateTime?
  estimatedHours Float?
  billable       Boolean   @default(true)
  active         Boolean   @default(true)

  timesheetEntries TimesheetEntry[]

  @@map("project_tasks")
}

model ProjectMember {
  id               Int      @id @default(autoincrement())
  projectId        Int
  project          Project  @relation(fields: [projectId], references: [id])
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  roleOnProject    String   @default("Member") // Project Admin | Member — a project may have several "Project Admin" rows
  maxHoursPerDay   Float?
  maxHoursPerWeek  Float?
  isFavorite       Boolean  @default(false)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Timesheet {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  weekStartDate DateTime
  // Single-level approval: Project Admin only (no more L1/L2 split — see
  // services/approvalRouting.ts). APPROVED is reached either by the Project
  // Admin acting, or immediately at submit time if the submitter is
  // themselves an admin of every project on this timesheet (self-approval).
  status        String   @default("DRAFT") // DRAFT|SUBMITTED|APPROVED|REJECTED|RECALLED
  weekNotes     String?
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries    TimesheetEntry[]
  approvals  Approval[]

  @@unique([userId, weekStartDate])
  @@map("timesheets")
}

model TimesheetEntry {
  id            Int         @id @default(autoincrement())
  timesheetId   Int
  timesheet     Timesheet   @relation(fields: [timesheetId], references: [id])
  projectTaskId Int
  projectTask   ProjectTask @relation(fields: [projectTaskId], references: [id])
  entryDate     DateTime
  hours         Float       @default(0)
  notes         String?

  @@unique([timesheetId, projectTaskId, entryDate])
  @@map("timesheet_entries")
}

model Approval {
  id          Int       @id @default(autoincrement())
  timesheetId Int
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])
  level       Int       @default(1) // always 1 now — single-level (Project Admin) approval; column kept for existing history rows
  approverId  Int
  approver    User      @relation("ApproverActions", fields: [approverId], references: [id])
  action      String    // APPROVED | REJECTED
  comment     String?
  actedAt     DateTime  @default(now())

  @@map("approvals")
}

/**
 * A record of one "send this project's timesheet to the client" action —
 * the actual email delivery is a logged placeholder (this app has never had
 * a real SMTP/email-API provider wired up anywhere, see notify.ts), but the
 * review/select/send workflow, the generated file, and this audit record
 * are all real.
 */
model ClientTimesheetSend {
  id             Int      @id @default(autoincrement())
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id])
  sentById       Int
  sentBy         User     @relation("ClientSendSentBy", fields: [sentById], references: [id])
  recipientEmail String
  periodStart    DateTime
  periodEnd      DateTime
  entryIds       String   // JSON-encoded array of included TimesheetEntry ids
  entryCount     Int      @default(0)
  totalHours     Float    @default(0)
  fileName       String
  createdAt      DateTime @default(now())

  @@map("client_timesheet_sends")
}

model Delegation {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  fromUser   User     @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User     @relation("DelegationTo", fields: [toUserId], references: [id])
  startDate  DateTime
  endDate    DateTime
  active     Boolean  @default(true)

  @@map("delegations")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  payload   String?   // JSON-encoded extra data
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model NotificationRule {
  id            Int      @id @default(autoincrement())
  scope         String   // Global | Department | Project
  scopeId       Int?
  type          String   // SubmissionReminder | OverdueSubmission | PendingApproval | Escalation
  cadenceConfig String   // JSON-encoded { days: [...], thresholdDays, ... }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notification_rules")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  // Set only when the action was performed during a Super Admin impersonation
  // session — actorId is still the impersonated user (whose data changed),
  // impersonatedById records who was really behind the wheel.
  impersonatedById Int?
  impersonatedBy   User? @relation("AuditImpersonator", fields: [impersonatedById], references: [id])
  entityType  String
  entityId    Int?
  action      String
  beforeState String?  // JSON-encoded
  afterState  String?  // JSON-encoded
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model ImportBatch {
  id           Int      @id @default(autoincrement())
  type         String   // Users | Projects
  uploadedById Int
  uploadedBy   User     @relation("ImportUploader", fields: [uploadedById], references: [id])
  fileName     String
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  errorRows    Int      @default(0)
  errorReport  String?  // JSON-encoded array of { row, errors[] }
  createdAt    DateTime @default(now())

  @@map("import_batches")
}

model Holiday {
  id         Int             @id @default(autoincrement())
  name       String
  date       DateTime
  calendarId Int
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id])

  @@map("holidays")
}

// One calendar's set of holidays, assignable to any number of Clients (but
// each Client points to at most one). Replaces the single global holiday
// list — different clients (and the internal "Vivid Edge" client that every
// employee's standing Time Off & Admin project belongs to) can now each see
// only the holidays relevant to them, color-coded per calendar so a day with
// holidays from more than one calendar shows every color it's covered by.
model HolidayCalendar {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  color    String // hex, e.g. "#1B4298"
  clients  Client[]
  holidays Holiday[]

  @@map("holiday_calendars")
}

model OrganizationSettings {
  id                   Int    @id @default(autoincrement())
  orgName              String @default("Vivid Edge Integration COE")
  timezone             String @default("Asia/Kolkata")
  workWeekStartDay     String @default("MONDAY") // MONDAY | SUNDAY
  standardHoursPerDay  Float  @default(8)
  weeklyHourLimit      Float  @default(40)
  fiscalYearStartMonth Int    @default(1)
  brandingLogoUrl      String @default("/brand/logo.svg")
  brandingPrimaryColor String @default("#1B4298")
  brandingAccentColor  String @default("#00AEEF")

  @@map("organization_settings")
}

model ApprovalChainConfig {
  id           Int    @id @default(autoincrement())
  scope        String // Global | Department | Project
  scopeId      Int?
  level1Role   String @default("PROJECT_ADMIN")
  level2Role   String @default("HR_ADMIN")

  @@map("approval_chain_configs")
}
