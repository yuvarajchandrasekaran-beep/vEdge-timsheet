# SQLite for local dev. Swap to a real MySQL DSN to run in production, e.g.:
# DATABASE_URL="mysql://user:password@localhost:3306/timesync"
# and change the `provider` in prisma/schema.prisma from "sqlite" to "mysql".
DATABASE_URL="file:./dev.db"

# Rotate this before deploying anywhere real.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# OAuth 2.0 Client ID (Web application) from console.cloud.google.com's
# "APIs & Services > Credentials" — required for the "Sign in with Google"
# button on the login screen. Login by password still works without this;
# the endpoint just returns 503 until it's set. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (frontend/.env.example) — same client ID, used on
# both sides.
GOOGLE_CLIENT_ID=
