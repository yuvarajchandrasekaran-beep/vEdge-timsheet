# SQLite for local dev. Swap to a real MySQL DSN to run in production, e.g.:
# DATABASE_URL="mysql://user:password@localhost:3306/timesync"
# and change the `provider` in prisma/schema.prisma from "sqlite" to "mysql".
DATABASE_URL="file:./dev.db"

# Rotate this before deploying anywhere real.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# OAuth 2.0 Client ID (Web application) from console.cloud.google.com's
# "APIs & Services > Credentials" — required for the "Sign in with Google"
# button on the login screen. Login by password still works without this;
# the endpoint just returns 503 until it's set. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (frontend/.env.example) — same client ID, used on
# both sides.
GOOGLE_CLIENT_ID=

# Set to "false" wherever real people sign in (production): every account
# starts with the same default password and can't change it yet, so password
# sign-in would let anyone in as anyone. Google sign-in only, then; the login
# page hides its password form. Unset (as here), password sign-in stays on for
# local and demo use.
PASSWORD_LOGIN_ENABLED=

# With PASSWORD_LOGIN_ENABLED=false: accounts that may still sign in with a
# password (comma-separated), such as a shared administrator account with no
# Google mailbox. Each needs its own password: the default one is refused.
PASSWORD_LOGIN_ALLOWED_EMAILS=
